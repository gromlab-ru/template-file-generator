{
  "name": "@gromlab/template-file-generator",
  "version": "0.3.0",
  "description": "Generate files and folder structures from local templates with a CLI, Node.js API, and agent skill",
  "author": "Gromov Sergei",
  "license": "MIT",
  "homepage": "https://github.com/gromlab-ru/template-file-generator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gromlab-ru/template-file-generator.git"
  },
  "bugs": {
    "url": "https://github.com/gromlab-ru/template-file-generator/issues"
  },
  "keywords": [
    "cli",
    "generator",
    "template",
    "scaffold",
    "boilerplate",
    "file-generator",
    "agent-skill"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "template-file-generator": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "README_RU.md"
  ],
  "scripts": {
    "clear": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clear && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "test": "node --test",
    "check:package": "node scripts/check-package.cjs",
    "check": "npm run build && npm test && npm run check:package",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "archy": "^1.0.0",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "change-case-all": "^2.1.0",
    "directory-tree": "^3.5.2",
    "figures": "^3.2.0",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/archy": "^0.0.31",
    "@types/node": "^20.11.24",
    "typescript": "^5.8.3"
  }
}
